# ─── Supabase (obrigatório) ───────────────────────────────────────────
# Encontre em: supabase.com/dashboard/project/SEU_PROJECT_ID/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=seu-project-id

# ─── Sentry — monitoramento de erros (opcional) ──────────────────────
# Encontre em: sentry.io → seu projeto → Settings → Client Keys
VITE_SENTRY_DSN=https://...@sentry.io/...

# ─── PWA Push Notifications (opcional) ──────────────────────────────
# Gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=BN...

# ─────────────────────────────────────────────────────────────────────
# As variáveis abaixo são Secrets das Edge Functions do Supabase.
# Configure em: supabase.com → projeto → Settings → Edge Functions → Secrets
# NUNCA adicione estas variáveis no frontend — são server-side only.
# ─────────────────────────────────────────────────────────────────────

# YOUTUBE_API_KEY=AIza...
# NEWSDATA_API_KEY=pub_...
# GNEWS_API_KEY=...
# CURRENTS_API_KEY=...
# THENEWSAPI_TOKEN=...
# NEWSAPI_KEY=...
# LOVABLE_API_KEY=...
# GOOGLE_MAPS_API_KEY=AIza...
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# FRED_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  ← NUNCA expor no cliente
# VAPID_PRIVATE_KEY=...             ← NUNCA expor no cliente
